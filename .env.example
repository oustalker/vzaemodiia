# Скопіюйте у .env і задайте власні значення. Сам .env у репозиторій не потрапляє.

# development або production. У production застосунок відмовиться стартувати
# з ключем із прикладу або з CORS_ORIGINS=*.
APP_ENV=development

# Ключ для підпису токенів.
# Згенерувати: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Час життя токена у хвилинах (за замовчуванням тиждень).
ACCESS_TOKEN_TTL=10080

# Кома-розділений перелік дозволених походжень. У production — без зірочки.
CORS_ORIGINS=*

# За замовчуванням SQLite поруч із проєктом. Для Postgres:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/vzaemodiia
